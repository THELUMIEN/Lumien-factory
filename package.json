{
  "name": "lumien-factory",
  "version": "0.1.0",
  "private": true,
  "description": "LUMIEN unified-system operational spine (public-safe). Validates Lumien_private artifact manifest against the unified lifecycle.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "lumien-factory": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "factory": "tsx src/cli.ts",
    "validate": "tsx src/cli.ts validate ./contracts",
    "graph": "tsx src/cli.ts graph",
    "test": "node --test --import tsx tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
